# ── Payment rails ───────────────────────────────────────────────────────────
# Every paid route accepts USDC on BOTH rails; the client picks one.
# These defaults are the suite's public receive addresses — change them to
# your own to get paid. The server logs a note while the defaults are in use.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# ── Networks ────────────────────────────────────────────────────────────────
# EVM network: base-sepolia (testnet, default) or base (mainnet).
NETWORK=base-sepolia
# Solana network: mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta
# Solana RPC used to build the SPL transfer the buyer signs.
# The public RPC is heavily rate-limited — use Helius/Triton/QuickNode in prod.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional devnet RPC for the browser checkout when SOLANA_NETWORK=devnet.
# SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# ── Facilitators (one per rail) ─────────────────────────────────────────────
# No public facilitator settles both chains, so each rail has its own.
# EVM: x402.org's free facilitator handles base-sepolia. For Base mainnet point
# this at a production facilitator (e.g. Coinbase Developer Platform's).
FACILITATOR_URL=https://x402.org/facilitator
# Solana: PayAI's facilitator settles the SVM rail.
SOLANA_FACILITATOR_URL=https://facilitator.payai.network

# ── Signing ─────────────────────────────────────────────────────────────────
# Secret for HMAC-SHA256 signatures on position tokens and refund claims.
# A position token is self-contained: it proves when you joined and what ETA
# you were promised — neither side can edit that after the fact.
# A development default is baked in — ALWAYS set your own in production.
SIGNING_SECRET=change-me-to-a-long-random-string

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4025
# Public origin, used to build the `resource` URL in 402 challenges and the
# positionUrl handed back at join time. Set it in production.
# PUBLIC_BASE_URL=https://queue.example.com

# Where tickets JSON lives (created automatically).
DATA_DIR=data
# Your venue, its queues, service rates and hold policy.
QUEUES_CONFIG=config/queues.json

# ── Client examples only ────────────────────────────────────────────────────
# Private key of the PAYING wallet for examples/agent-client.ts (EVM rail).
# Fund with base-sepolia USDC: https://faucet.circle.com
# PRIVATE_KEY=0x...
# BASE_URL=http://localhost:4025
